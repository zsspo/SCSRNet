{
    "name": "HSMS fusion",
    "experim_name": "Experiments_lk",
    "model": "SCSRNet",
    "N_modules": 1,
    "train_dataset": "chikusei_dataset",
    "is_DHP_MS": false,
    "train_batch_size": 2,
